dim(allresult_PFA2.df) #[1] 27641    10
extracted_result_PFA2.df <- allresult_PFA2.df %>% 
  dplyr::select(gene_id, gene_name, gene_type, baseMean, log2FoldChange,  padj) %>%
  arrange(padj, desc(log2FoldChange))
dim(extracted_result_PFA2.df) #[1] 27641     6
